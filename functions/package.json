{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "content:build": "node scripts/buildContentPacks.js",
    "content:migrate-images": "node scripts/migrateImageSources.js",
    "content:publish": "node scripts/publishContentPacks.js",
    "content:release": "node scripts/releaseContentPack.js",
    "question:audit": "node scripts/auditQuestionBank.js",
    "question:audit-options": "node scripts/auditOptionLengthBias.js",
    "question:apply-option-repairs": "node scripts/applyOptionChoiceRepairs.js && node scripts/suggestReadingLengthBalance.js --apply && node scripts/applyOptionChoiceRepairs.js question-reviews/act-reading-form-balance-repairs.json",
    "question:review:prepare": "node scripts/prepareQuestionReview.js",
    "seed:analytics:emulator": "node scripts/seedAnalyticsEmulator.js",
    "demo:riverview": "node scripts/riverviewDemo.js",
    "test-users:verify": "node scripts/verifyTestUsers.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2-rc.0",
    "googleapis": "^176.0.0",
    "stripe": "^22.3.2",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
