# Non-secret Cloud Functions configuration.
# Copy these values to .env.drill-instructor-pro for production deployment.
WEB_APP_URL=https://your-web-app.example
STRIPE_PRICE_ACT_MONTHLY=price_replace_me
STRIPE_PRICE_ACT_ANNUAL=price_replace_me
STRIPE_PRICE_SAT_MONTHLY=price_replace_me
STRIPE_PRICE_SAT_ANNUAL=price_replace_me

# Keep disabled for emulators until web/iOS/Android clients send valid tokens.
# Set to required only after monitoring registered apps in Firebase App Check.
APP_CHECK_ENFORCEMENT=disabled

# Apple App Store verification (non-secret metadata).
APPLE_BUNDLE_ID=com.drillinstructor.app
APPLE_APP_ID=replace_with_numeric_app_apple_id
APPLE_ENVIRONMENT=Production

# Google Play verification and authenticated Pub/Sub push.
GOOGLE_PLAY_PACKAGE_NAME=com.drillinstructor.app
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://us-central1-your-project.cloudfunctions.net/googlePlayNotificationsHttps
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=play-rtdn-push@your-project.iam.gserviceaccount.com
