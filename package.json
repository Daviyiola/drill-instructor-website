{
  "name": "drill-instructor-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:question-images": "node scripts/prepare-question-images.mjs",
    "prepare:profile-units": "node scripts/prepare-profile-units.mjs",
    "english:validate-source": "node question-generator/act/english/validate-source.js",
    "english:validate-prompts": "node question-generator/act/english/validate-prompts.js",
    "english:validate-production": "node question-generator/act/english/validate-production-manifest.js",
    "english:prepare-source": "node question-generator/act/english/prepare-source.js",
    "english:validate-bundle": "node question-generator/act/english/validate-generated-bundle.js",
    "english:validate-form": "node question-generator/act/english/validate-form.js",
    "english:measure-similarity": "node question-generator/act/english/measure-source-similarity.js",
    "english:import-act": "node question-generator/act/english/import-into-act-data.js",
    "english:calibrate-original": "node question-generator/act/english/calibrate-original-forms.js",
    "english:validate-original": "node question-generator/act/english/validate-original-forms.js",
    "act:finalize-tests": "node question-generator/act/finalize/finalize-practice-tests.js",
    "sat:finalize-tests": "node question-generator/sat/finalize/finalize-practice-tests.js",
    "content:release": "node functions/scripts/releaseContentPack.js",
    "demo:riverview": "node functions/scripts/riverviewDemo.js",
    "test:rules:deployed": "firebase emulators:exec --only database --project demo-drill-instructor \"node --test Firebase/test/rtdb-rules.test.js Firebase/test/no-direct-rtdb-client.test.js\"",
    "test:rules:candidate": "firebase emulators:exec --only database --project demo-drill-instructor \"node --test Firebase/test/rtdb-rules.test.js Firebase/test/no-direct-rtdb-client.test.js\" --config firebase.candidate.json"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "next": "16.2.11",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "firebase-tools": "^15.24.0",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
