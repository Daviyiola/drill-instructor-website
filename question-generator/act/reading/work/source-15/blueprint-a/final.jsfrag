{
271: {skill_tested: "Identify a tradeoff.", question: "What risk accompanies waiting too long at a stopover?", option1: "The bird may lose favorable winds or arrive late for nesting space.", option2: "Its wing length immediately decreases.", option3: "It can no longer measure wind direction.", option4: "All food becomes permanently unavailable after one night.", correctAnswer: "The bird may lose favorable winds or arrive late for nesting space.", explanation: "Step 1: The opening contrasts fuel gain with timing costs.<br><br>Answer: The bird may lose favorable winds or arrive late for nesting space.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
272: {skill_tested: "Identify measurement purpose.", question: "Why do researchers combine mass with wing length?", option1: "To determine wind speed without a station.", option2: "To estimate fuel condition more meaningfully across birds of different size.", option3: "To locate every future stopover.", option4: "To make transmitters record feeding.", correctAnswer: "To estimate fuel condition more meaningfully across birds of different size.", explanation: "Step 1: Raw mass is not a precise standalone measure of reserves.<br><br>Answer: To estimate fuel condition more meaningfully across birds of different size.", practiceYear: 1, difficulty: "Medium", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
273: {skill_tested: "State central idea.", question: "Which statement best summarizes the passage?", option1: "Every bird leaves at one fixed mass.", option2: "Wind alone determines migration timing.", option3: "Departure reflects a shifting balance among fuel, weather, season, habitat, and risk.", option4: "Stopover decisions cannot be studied empirically.", correctAnswer: "Departure reflects a shifting balance among fuel, weather, season, habitat, and risk.", explanation: "Step 1: The threshold changes with several interacting conditions.<br><br>Answer: Departure reflects a shifting balance among fuel, weather, season, habitat, and risk.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
274: {skill_tested: "Explain substitution.", question: "How can high fuel partly substitute for favorable wind?", option1: "Fuel changes a headwind into a tailwind.", option2: "Well-fueled birds no longer expend energy.", option3: "Fuel prevents seasonal urgency.", option4: "Extra reserves may cover the greater energy cost of weaker winds.", correctAnswer: "Extra reserves may cover the greater energy cost of weaker winds.", explanation: "Step 1: Energetic reserves can offset, within limits, a costlier flight.<br><br>Answer: Extra reserves may cover the greater energy cost of weaker winds.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
275: {skill_tested: "Infer seasonal behavior.", question: "Why are later birds more willing to depart in poor winds?", option1: "The cost of further delay has increased.", option2: "Late-season winds contain more oxygen.", option3: "Their transmitters force departure.", option4: "Food abundance always rises late in migration.", correctAnswer: "The cost of further delay has increased.", explanation: "Step 1: Urgency changes the acceptable weather threshold.<br><br>Answer: The cost of further delay has increased.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
276: {skill_tested: "Analyze comparison design.", question: "Matching birds by date and fuel before comparing wind changes helps researchers:", option1: "prove all birds share the same experience.", option2: "isolate the short-term association between wind and departure.", option3: "remove the need to record departure.", option4: "measure nesting space at the destination.", correctAnswer: "isolate the short-term association between wind and departure.", explanation: "Step 1: Controlling major alternatives makes the rapid wind response more informative.<br><br>Answer: isolate the short-term association between wind and departure.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
277: {skill_tested: "Interpret habitat effect.", question: "Why might a bird leave a poor feeding site with lower reserves?", option1: "Poor sites always have supportive winds.", option2: "Low reserves eliminate flight costs.", option3: "Additional waiting may yield little fuel, and a nearer stop may be reachable.", option4: "Falcons avoid depleted habitats completely.", correctAnswer: "Additional waiting may yield little fuel, and a nearer stop may be reachable.", explanation: "Step 1: Low expected gain changes the relative value of leaving.<br><br>Answer: Additional waiting may yield little fuel, and a nearer stop may be reachable.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
278: {skill_tested: "Evaluate evidence limits.", question: "Why is departure time alone insufficient after a falcon appears?", option1: "Radio tags stop working near predators.", option2: "Researchers cannot observe feeding behavior.", option3: "Flight direction never provides useful evidence.", option4: "The falcon may reduce feeding or directly encourage departure, producing different mechanisms.", correctAnswer: "The falcon may reduce feeding or directly encourage departure, producing different mechanisms.", explanation: "Step 1: The same timing outcome can arise through distinct causal paths.<br><br>Answer: The falcon may reduce feeding or directly encourage departure, producing different mechanisms.", practiceYear: 1, difficulty: "Very Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
279: {skill_tested: "Interpret moving threshold.", question: "Calling the threshold moving most nearly means that:", option1: "the amount of fuel sufficient for departure changes with surrounding costs and opportunities.", option2: "birds physically relocate the weather station.", option3: "fuel has no role in flight readiness.", option4: "every condition changes at a constant rate.", correctAnswer: "the amount of fuel sufficient for departure changes with surrounding costs and opportunities.", explanation: "Step 1: Readiness is conditional rather than a fixed numerical trigger.<br><br>Answer: the amount of fuel sufficient for departure changes with surrounding costs and opportunities.", practiceYear: 1, difficulty: "Very Hard", module: "Vocabulary in Context", imageSources: [], passage: "{{shared_passage}}"}
}
