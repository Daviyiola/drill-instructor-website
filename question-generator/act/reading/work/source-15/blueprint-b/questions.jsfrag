{
280: {skill_tested: "Identify how phase change stores energy.", question: "According to the first paragraph, how does a phase-change material store heat differently from an ordinary wall?", option1: "It generates cold whenever its temperature rises.", option2: "It absorbs substantial energy while melting near a stable temperature.", option3: "It stores energy only by increasing its mass.", option4: "It prevents all heat from entering a room.", correctAnswer: "It absorbs substantial energy while melting near a stable temperature.", explanation: "Step 1: An ordinary wall stores heat as its temperature rises.<br><br>Step 2: The phase-change material also absorbs energy during melting while staying near its transition temperature.<br><br>Answer: It absorbs substantial energy while melting near a stable temperature.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
281: {skill_tested: "Identify the purpose of microcapsules.", question: "Why are phase-change substances enclosed in tiny shells before being blended into panels?", option1: "To raise every substance's melting point above indoor temperature", option2: "To ensure the core conducts heat instantly", option3: "To contain the liquid phase and separate it from surrounding material", option4: "To eliminate the need for a panel binder", correctAnswer: "To contain the liquid phase and separate it from surrounding material", explanation: "Step 1: Waxes or salts may leak when they melt or react with other materials.<br><br>Step 2: Capsule shells contain each droplet while allowing it to be mixed into a composite.<br><br>Answer: To contain the liquid phase and separate it from surrounding material", practiceYear: 1, difficulty: "Medium", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
282: {skill_tested: "Identify the passage's central claim.", question: "Which statement best expresses the passage's central idea?", option1: "The material with the largest measured heat capacity will succeed in every building.", option2: "Microcapsules generate cooling without releasing stored heat.", option3: "A phase-change panel works best when it remains liquid every night.", option4: "Phase-change materials can shift heat in time, but useful performance depends on containment, transfer rate, durability, operating temperatures, and system integration.", correctAnswer: "Phase-change materials can shift heat in time, but useful performance depends on containment, transfer rate, durability, operating temperatures, and system integration.", explanation: "Step 1: Melting and freezing provide reusable thermal storage.<br><br>Step 2: The passage identifies shell, strength, conductivity, cycling, schedule, placement, and control constraints.<br><br>Answer: Phase-change materials can shift heat in time, but useful performance depends on containment, transfer rate, durability, operating temperatures, and system integration.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
283: {skill_tested: "Infer why melting range must match use conditions.", question: "A material that melts well below normal room temperature would be poorly suited to absorbing an afternoon indoor heat peak because it would likely:", option1: "already be liquid and have little unused phase-change capacity.", option2: "remain permanently frozen during the afternoon.", option3: "increase the wall's mechanical strength too much.", option4: "prevent heat from reaching its capsules.", correctAnswer: "already be liquid and have little unused phase-change capacity.", explanation: "Step 1: Storage occurs as solid material melts.<br><br>Step 2: A very low melting material will have completed that transition before the room reaches its afternoon peak.<br><br>Step 3: With little solid phase remaining, it cannot absorb much more latent heat.<br><br>Answer: already be liquid and have little unused phase-change capacity.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
284: {skill_tested: "Analyze a composite-design tradeoff.", question: "Why can increasing the proportion of microcapsules eventually weaken a wall panel?", option1: "The active cores become heavier each time they melt.", option2: "Capsules interrupt the binder and their shells contribute little structural strength.", option3: "More capsules always reduce stored thermal energy.", option4: "Capsules prevent the panel from having any melting range.", correctAnswer: "Capsules interrupt the binder and their shells contribute little structural strength.", explanation: "Step 1: More capsules increase active storage material.<br><br>Step 2: They also occupy space in the composite and may interfere with the strength-giving binder.<br><br>Step 3: Storage concentration and mechanical durability must be balanced rather than maximized independently.<br><br>Answer: Capsules interrupt the binder and their shells contribute little structural strength.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
285: {skill_tested: "Distinguish storage capacity from delivery rate.", question: "A thick panel can possess high theoretical capacity yet perform poorly during a short hot afternoon if:", option1: "all capsules melt and freeze instantaneously.", option2: "the panel is tested for flame spread.", option3: "heat moves too slowly to reach much of the material before the peak passes.", option4: "conductive additions reduce the time needed for charging.", correctAnswer: "heat moves too slowly to reach much of the material before the peak passes.", explanation: "Step 1: Capacity measures how much heat the material can store.<br><br>Step 2: Poor conductivity limits how quickly inner material can receive that heat.<br><br>Step 3: Capacity unavailable within the relevant time window cannot buffer the peak effectively.<br><br>Answer: heat moves too slowly to reach much of the material before the peak passes.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
286: {skill_tested: "Explain why component tests do not establish product readiness.", question: "Why might a capsule that performs well in a sealed vial still fail in a building panel?", option1: "A sealed vial always has a lower temperature than a building.", option2: "Panel tests measure only the color of the capsule shell.", option3: "The phase-change core stops absorbing energy when placed near a binder.", option4: "Manufacturing, cutting, binder interactions, moisture, fire requirements, and mechanical loads introduce additional conditions.", correctAnswer: "Manufacturing, cutting, binder interactions, moisture, fire requirements, and mechanical loads introduce additional conditions.", explanation: "Step 1: Vial tests isolate capsule thermal behavior.<br><br>Step 2: Panels must survive mixing and construction while meeting structural, moisture, flame, and heat-flow requirements.<br><br>Step 3: Product performance depends on integration conditions absent from the isolated test.<br><br>Answer: Manufacturing, cutting, binder interactions, moisture, fire requirements, and mechanical loads introduce additional conditions.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
287: {skill_tested: "Evaluate the thermal-battery analogy.", question: "Why does the author call the thermal-battery comparison both useful and potentially misleading?", option1: "The panel shifts energy in time like a battery, but it does not create cooling and works only within a limited temperature cycle.", option2: "The panel stores electricity but cannot release heat.", option3: "Batteries and panels use identical chemical reactions.", option4: "The analogy proves that release timing cannot affect energy use.", correctAnswer: "The panel shifts energy in time like a battery, but it does not create cooling and works only within a limited temperature cycle.", explanation: "Step 1: Both systems store energy for release at another time.<br><br>Step 2: The panel's storage depends on melting and freezing and only delays part of a heat load.<br><br>Step 3: Whether that delay helps depends on when and where the heat is later released.<br><br>Answer: The panel shifts energy in time like a battery, but it does not create cooling and works only within a limited temperature cycle.", practiceYear: 1, difficulty: "Very Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
288: {skill_tested: "Synthesize material properties with operating context.", question: "Which proposed building test would best evaluate the technology according to the passage's full standard of success?", option1: "Measure one capsule's heat capacity once at its ideal temperature.", option2: "Compare occupied rooms across repeated weather cycles while tracking panel condition, indoor peaks, reset energy, and release timing.", option3: "Count capsules before they are mixed into a binder.", option4: "Select the panel with the highest advertised storage value without measuring heat flow.", correctAnswer: "Compare occupied rooms across repeated weather cycles while tracking panel condition, indoor peaks, reset energy, and release timing.", explanation: "Step 1: Useful performance combines durability, capacity, rate, melting range, schedule, and system interaction.<br><br>Step 2: Repeated occupied-room tests expose actual charging, nighttime reset, release, and physical aging.<br><br>Step 3: Tracking both comfort peaks and reset energy determines whether shifting heat produces a real building benefit.<br><br>Answer: Compare occupied rooms across repeated weather cycles while tracking panel condition, indoor peaks, reset energy, and release timing.", practiceYear: 1, difficulty: "Very Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"}
}
