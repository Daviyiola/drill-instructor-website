{
109: {skill_tested: "Identify research limits.", question: "What did observers deliberately avoid recording?", option1: "How long visitors stayed.", option2: "Whether visitors arrived alone.", option3: "People's names and conversations.", option4: "Where visitors sat.", correctAnswer: "People's names and conversations.", explanation: "Step 1: The study recorded visible spatial behavior but excluded identities and conversation content.<br><br>Answer: People's names and conversations.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
110: {skill_tested: "Identify a central claim.", question: "What is the passage's main idea?", option1: "Movable chairs always create conversations between strangers.", option2: "Fixed benches should be removed from every plaza.", option3: "Researchers can infer private motives directly from seating choices.", option4: "Seating design shapes opportunities for behavior without fully determining why people act as they do.", correctAnswer: "Seating design shapes opportunities for behavior without fully determining why people act as they do.", explanation: "Step 1: The passage balances patterned design effects with limits on causal interpretation.<br><br>Answer: Seating design shapes opportunities for behavior without fully determining why people act as they do.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
111: {skill_tested: "Interpret a detail.", question: "Why was the stone wall useful to bus riders?", option1: "It offered a clear view of arriving buses and adjustable personal distance.", option2: "It was warmer than every official bench.", option3: "It faced away from all routes.", option4: "It contained built-in schedule displays.", correctAnswer: "It offered a clear view of arriving buses and adjustable personal distance.", explanation: "Step 1: Its location and continuous surface matched the practical needs of waiting riders.<br><br>Answer: It offered a clear view of arriving buses and adjustable personal distance.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
112: {skill_tested: "Analyze function.", question: "The three-day increase in conversations is presented mainly to:", option1: "prove street music is the sole cause of conversation.", option2: "illustrate why simultaneous changes make a causal conclusion uncertain.", option3: "show that weather never affects public space.", option4: "demonstrate that fountains prevent social contact.", correctAnswer: "illustrate why simultaneous changes make a causal conclusion uncertain.", explanation: "Step 1: Several conditions changed together, so the observation is suggestive but not isolating.<br><br>Answer: illustrate why simultaneous changes make a causal conclusion uncertain.", practiceYear: 1, difficulty: "Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
113: {skill_tested: "Infer from an experiment.", question: "People moved face-to-face chairs more often because that arrangement likely:", option1: "made the chairs physically heavier.", option2: "blocked all views of the plaza.", option3: "demanded more direct attention than some solitary users wanted.", option4: "was reserved for maintenance workers.", correctAnswer: "demanded more direct attention than some solitary users wanted.", explanation: "Step 1: The right-angle arrangement better accommodated both interaction and independent watching.<br><br>Answer: demanded more direct attention than some solitary users wanted.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
114: {skill_tested: "Explain a relationship.", question: "How does the passage relate flexibility to successful seating?", option1: "Flexibility eliminates the need for varied locations.", option2: "Movable seats reveal every visitor's motive.", option3: "Flexible furniture is never rearranged.", option4: "Flexibility lets users adjust the balance between connection and separation.", correctAnswer: "Flexibility lets users adjust the balance between connection and separation.", explanation: "Step 1: Users can reposition seating to negotiate attention and boundaries.<br><br>Answer: Flexibility lets users adjust the balance between connection and separation.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
115: {skill_tested: "Determine perspective.", question: "The author's attitude toward observational research is best described as:", option1: "supportive when its conclusions acknowledge uncertainty.", option2: "dismissive because visible patterns have no value.", option3: "certain that observation explains private motives.", option4: "concerned only with furniture cost.", correctAnswer: "supportive when its conclusions acknowledge uncertainty.", explanation: "Step 1: The author values repeated patterns while emphasizing bounded claims.<br><br>Answer: supportive when its conclusions acknowledge uncertainty.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
116: {skill_tested: "Synthesize evidence and qualification.", question: "Which finding would best support the passage's conclusion without exceeding its limits?", option1: "One visitor says every person prefers the same bench.", option2: "Different seating arrangements repeatedly attract different uses, though interviews reveal varied personal reasons.", option3: "A planner claims a new bench guarantees friendship.", option4: "No one ever alters a movable chair.", correctAnswer: "Different seating arrangements repeatedly attract different uses, though interviews reveal varied personal reasons.", explanation: "Step 1: The answer combines stable behavioral patterns with diverse motives.<br><br>Answer: Different seating arrangements repeatedly attract different uses, though interviews reveal varied personal reasons.", practiceYear: 1, difficulty: "Very Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
117: {skill_tested: "Evaluate final reasoning.", question: "Why does the author call the study's limitation useful?", option1: "It proves public furniture has no effects.", option2: "It allows researchers to stop collecting evidence.", option3: "It redirects planners from controlling behavior toward supporting multiple choices.", option4: "It ensures every plaza will look identical.", correctAnswer: "It redirects planners from controlling behavior toward supporting multiple choices.", explanation: "Step 1: Acknowledged uncertainty leads to a plural, opportunity-based design goal.<br><br>Answer: It redirects planners from controlling behavior toward supporting multiple choices.", practiceYear: 1, difficulty: "Very Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"}
}
