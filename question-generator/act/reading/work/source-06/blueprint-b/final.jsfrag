{
118: {skill_tested: "Identify a physiological tradeoff.", question: "What is one disadvantage of a cool roost?", option1: "It prevents metabolism from slowing.", option2: "It always causes dangerous water loss.", option3: "It attracts more insects into the box.", option4: "A torpid bat may need more time to warm its muscles before flight.", correctAnswer: "A torpid bat may need more time to warm its muscles before flight.", explanation: "Step 1: Cool conditions save resting energy but lengthen reheating.<br><br>Answer: A torpid bat may need more time to warm its muscles before flight.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
119: {skill_tested: "Identify experimental design.", question: "Why did researchers rotate panels among boxes?", option1: "To separate temperature effects from preferences for particular locations.", option2: "To make every box the same color.", option3: "To measure the bats' body mass.", option4: "To keep owls permanently near one box.", correctAnswer: "To separate temperature effects from preferences for particular locations.", explanation: "Step 1: Moving treatments tests whether behavior tracks warmth rather than site.<br><br>Answer: To separate temperature effects from preferences for particular locations.", practiceYear: 1, difficulty: "Medium", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
120: {skill_tested: "State the main idea.", question: "Which statement best summarizes the passage?", option1: "All bats consistently choose the coolest shelter.", option2: "Bats adjust roost choices as the benefits and costs of warmth change with conditions.", option3: "Panel color alone determines every roost choice.", option4: "Predator sounds cause bats to stop using roosts.", correctAnswer: "Bats adjust roost choices as the benefits and costs of warmth change with conditions.", explanation: "Step 1: The findings show flexible tradeoffs across risk, offspring, and weather.<br><br>Answer: Bats adjust roost choices as the benefits and costs of warmth change with conditions.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
121: {skill_tested: "Infer a mechanism.", question: "Why might warmer roosts be favored after owl recordings?", option1: "Warmth makes bats invisible to owls.", option2: "Heated boxes prevent all sounds from entering.", option3: "Warm muscles may permit a faster departure if danger returns.", option4: "Owls can fly only in cool air.", correctAnswer: "Warm muscles may permit a faster departure if danger returns.", explanation: "Step 1: Reduced reheating time improves readiness for flight.<br><br>Answer: Warm muscles may permit a faster departure if danger returns.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
122: {skill_tested: "Analyze corroborating evidence.", question: "The secretly heated boxes strengthen the thermal interpretation because they:", option1: "contained no temperature sensors.", option2: "were moved to another canyon.", option3: "prevented bats from leaving after dawn.", option4: "changed internal warmth without changing the visible exterior cue.", correctAnswer: "changed internal warmth without changing the visible exterior cue.", explanation: "Step 1: The manipulation isolates internal temperature from panel appearance.<br><br>Answer: changed internal warmth without changing the visible exterior cue.", practiceYear: 1, difficulty: "Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
123: {skill_tested: "Explain subgroup differences.", question: "Females carrying young likely favor warmth because:", option1: "young bats regulate temperature poorly and may grow more slowly when repeatedly cooled.", option2: "adult females cannot enter torpor.", option3: "warm boxes contain no other adults.", option4: "offspring require owl recordings to sleep.", correctAnswer: "young bats regulate temperature poorly and may grow more slowly when repeatedly cooled.", explanation: "Step 1: Reproductive needs alter the energy tradeoff.<br><br>Answer: young bats regulate temperature poorly and may grow more slowly when repeatedly cooled.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
124: {skill_tested: "Interpret qualification.", question: "The hot-afternoon result demonstrates that:", option1: "bats never respond to temperature.", option2: "a useful trait can become harmful beyond certain conditions.", option3: "dark panels remain safe at every temperature.", option4: "predator risk is the only influence on shelter.", correctAnswer: "a useful trait can become harmful beyond certain conditions.", explanation: "Step 1: Excessive warmth creates water-loss risk and reverses preference.<br><br>Answer: a useful trait can become harmful beyond certain conditions.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
125: {skill_tested: "Evaluate alternatives.", question: "Which result most directly weakens the claim that bats merely avoided one cliff location?", option1: "Sensors recorded wall temperature.", option2: "Some bats stayed until morning.", option3: "Preferences changed when thermal panels were rotated among locations.", option4: "Females often used warm boxes.", correctAnswer: "Preferences changed when thermal panels were rotated among locations.", explanation: "Step 1: Tracking treatment across places distinguishes warmth from fixed-location avoidance.<br><br>Answer: Preferences changed when thermal panels were rotated among locations.", practiceYear: 1, difficulty: "Very Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
126: {skill_tested: "Synthesize the study.", question: "The passage treats apparent inconsistency in roost choice as evidence of:", option1: "random movement with no measurable pattern.", option2: "failure to recognize previously used shelters.", option3: "a permanent preference learned at birth.", option4: "context-sensitive decisions among competing biological demands.", correctAnswer: "context-sensitive decisions among competing biological demands.", explanation: "Step 1: Different conditions change the value of the same temperature.<br><br>Answer: context-sensitive decisions among competing biological demands.", practiceYear: 1, difficulty: "Very Hard", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"}
