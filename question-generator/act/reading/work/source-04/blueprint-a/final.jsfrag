{
73: {skill_tested: "Identify a stated sorting decision.", question: "Why does Mrs. Alvarez place the mitten beside the notebook?", option1: "Both are beyond repair.", option2: "The notebook describes how to wash the mitten.", option3: "They may have come from the same household.", option4: "Their colors match.", correctAnswer: "They may have come from the same household.", explanation: "Step 1: The matching surname suggests a shared household, so proximity may help an owner recognize both.<br><br>Answer: They may have come from the same household.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
74: {skill_tested: "Determine contextual meaning.", question: "In Passage A, the word legible most nearly means:", option1: "written in large letters.", option2: "safe from further water damage.", option3: "arranged by monetary value.", option4: "capable of being understood.", correctAnswer: "capable of being understood.", explanation: "Step 1: The room becomes less neat but its uncertain relationships become more understandable.<br><br>Answer: capable of being understood.", practiceYear: 1, difficulty: "Medium", module: "Vocabulary in Context", imageSources: [], passage: "{{shared_passage}}"},
75: {skill_tested: "Identify a shared idea.", question: "Which idea is shared by both passages?", option1: "Use can give ordinary objects meanings that fixed categories do not capture.", option2: "Damaged objects should always be replaced.", option3: "Digital records preserve memory better than physical objects.", option4: "Ownership can be established only through written names.", correctAnswer: "Use can give ordinary objects meanings that fixed categories do not capture.", explanation: "Step 1: The recovered belongings and worn map gain meaning through connections and experience.<br><br>Answer: Use can give ordinary objects meanings that fixed categories do not capture.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
76: {skill_tested: "Analyze a character shift.", question: "The blue cup causes the narrator of Passage A to recognize that:", option1: "all damaged dishes should be discarded.", option2: "an object's significance may depend on a story supplied by its owner.", option3: "Mrs. Alvarez knows every displaced resident.", option4: "volunteers should avoid speaking with visitors.", correctAnswer: "an object's significance may depend on a story supplied by its owner.", explanation: "Step 1: The cup's category changes when the man explains its connection to his wife.<br><br>Answer: an object's significance may depend on a story supplied by its owner.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
77: {skill_tested: "Analyze structural function.", question: "The map's coffee ring and torn corner primarily serve to:", option1: "prove the map is no longer accurate.", option2: "explain why the transit authority created an app.", option3: "show how physical wear records particular experiences.", option4: "show that the narrator is careless with every possession.", correctAnswer: "show how physical wear records particular experiences.", explanation: "Step 1: Each mark is tied to a remembered trip, turning wear into a personal record.<br><br>Answer: show how physical wear records particular experiences.", practiceYear: 1, difficulty: "Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
78: {skill_tested: "Trace a sequence of understanding.", question: "Which event most directly changes the narrator's reaction to losing the map?", option1: "Buying the original map from a kiosk.", option2: "Waiting while a train stops between stations.", option3: "Folding a new map along printed lines.", option4: "Imagining the boy using it at the aquarium.", correctAnswer: "Imagining the boy using it at the aquarium.", explanation: "Step 1: The imagined continued use transforms irritation into acceptance.<br><br>Answer: Imagining the boy using it at the aquarium.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
79: {skill_tested: "Compare perspectives.", question: "The narrators differ in that Passage A's narrator learns to preserve possible connections, while Passage B's narrator learns to:", option1: "accept that a meaningful object can continue its life with someone else.", option2: "recover every object from a single home.", option3: "replace paper maps with digital directions.", option4: "prevent strangers from handling personal belongings.", correctAnswer: "accept that a meaningful object can continue its life with someone else.", explanation: "Step 1: Passage B ends by accepting transfer rather than preserving possession.<br><br>Answer: accept that a meaningful object can continue its life with someone else.", practiceYear: 1, difficulty: "Hard", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"},
80: {skill_tested: "Synthesize symbolic roles.", question: "The unlabeled spaces in Passage A and the blank new map in Passage B both represent:", option1: "evidence that the narrators have failed.", option2: "possibilities that future experience may fill.", option3: "places from which all memories have been erased permanently.", option4: "official systems that cannot be revised.", correctAnswer: "possibilities that future experience may fill.", explanation: "Step 1: Both forms of blankness leave room for later connections rather than signaling emptiness alone.<br><br>Answer: possibilities that future experience may fill.", practiceYear: 1, difficulty: "Very Hard", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"},
81: {skill_tested: "Compare development of meaning.", question: "Which statement best compares how meaning develops in the passages?", option1: "Both passages locate meaning only in an object's original condition.", option2: "Passage A rejects stories while Passage B rejects physical evidence.", option3: "Passage A builds meaning by reuniting scattered clues, whereas Passage B follows meaning as it travels from one user to another.", option4: "Both narrators know from the beginning what each object will signify.", correctAnswer: "Passage A builds meaning by reuniting scattered clues, whereas Passage B follows meaning as it travels from one user to another.", explanation: "Step 1: One passage reconstructs connections; the other tracks a meaningful object's circulation.<br><br>Answer: Passage A builds meaning by reuniting scattered clues, whereas Passage B follows meaning as it travels from one user to another.", practiceYear: 1, difficulty: "Very Hard", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"}
}
