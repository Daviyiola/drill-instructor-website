{
127: {skill_tested: "Identify a navigation cue.", question: "What information do polarized-light patterns provide?", option1: "Direction.", option2: "The chemical identity of food.", option3: "The exact width of the nest.", option4: "The age of a landmark.", correctAnswer: "Direction.", explanation: "Step 1: The passage distinguishes celestial direction from step-based distance.<br><br>Answer: Direction.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
128: {skill_tested: "Identify method.", question: "Why were ants moved to a flat testing field?", option1: "To expose them to stronger scent trails.", option2: "To test their internal route estimate without retracing familiar landmarks.", option3: "To prevent them from beginning a search.", option4: "To change the length of their legs.", correctAnswer: "To test their internal route estimate without retracing familiar landmarks.", explanation: "Step 1: Displacement reveals stored path integration.<br><br>Answer: To test their internal route estimate without retracing familiar landmarks.", practiceYear: 1, difficulty: "Medium", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
129: {skill_tested: "State the central idea.", question: "Which statement best summarizes the passage?", option1: "Ants follow a single fixed sky signal without correction.", option2: "Landmarks are the only reliable desert cue.", option3: "Ants navigate by comparing imperfect cues, recalibrating them, and searching when uncertainty remains.", option4: "Navigation ends whenever cues disagree.", correctAnswer: "Ants navigate by comparing imperfect cues, recalibrating them, and searching when uncertainty remains.", explanation: "Step 1: The passage emphasizes integration, adjustment, and uncertainty.<br><br>Answer: Ants navigate by comparing imperfect cues, recalibrating them, and searching when uncertainty remains.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
130: {skill_tested: "Infer from reversed error.", question: "Why did experienced ants err in the opposite direction after the filter was removed?", option1: "They forgot the feeder's distance entirely.", option2: "The testing field contained the filter.", option3: "Their step length permanently doubled.", option4: "Their prior calibration continued briefly under normal sky conditions.", correctAnswer: "Their prior calibration continued briefly under normal sky conditions.", explanation: "Step 1: An adjustment useful under distortion creates a reversed error when distortion disappears.<br><br>Answer: Their prior calibration continued briefly under normal sky conditions.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
131: {skill_tested: "Analyze a variable.", question: "The slope-reversal experiment was designed chiefly to test whether ants:", option1: "use a nonvisual directional cue when evaluating the sky signal.", option2: "prefer walking downhill to finding food.", option3: "count only steps taken on flat ground.", option4: "can see through channel walls.", correctAnswer: "use a nonvisual directional cue when evaluating the sky signal.", explanation: "Step 1: Gravity-related slope information was manipulated independently of light.<br><br>Answer: use a nonvisual directional cue when evaluating the sky signal.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
132: {skill_tested: "Interpret extreme conflict.", question: "Broad searches after extreme filter rotation suggest that ants:", option1: "always accept the newest cue as correct.", option2: "lower confidence when available cues disagree too sharply.", option3: "become unable to walk after seeing polarized light.", option4: "estimate distance only from clouds.", correctAnswer: "lower confidence when available cues disagree too sharply.", explanation: "Step 1: Extreme disagreement disrupts the combined estimate rather than forcing a simple switch.<br><br>Answer: lower confidence when available cues disagree too sharply.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
133: {skill_tested: "Explain fading calibration.", question: "What possible benefit does fading calibration provide?", option1: "It makes every past route equally strong.", option2: "It removes the need to compare cues.", option3: "It prevents a temporary distortion from controlling navigation indefinitely.", option4: "It causes ants to retain extreme errors.", correctAnswer: "It prevents a temporary distortion from controlling navigation indefinitely.", explanation: "Step 1: Decay allows adaptation without making local conditions permanent.<br><br>Answer: It prevents a temporary distortion from controlling navigation indefinitely.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
134: {skill_tested: "Synthesize search behavior.", question: "Why does the author describe the widening search as part of navigation rather than failure?", option1: "It always leads directly to food.", option2: "It replaces all directional calculations.", option3: "It proves the nest has moved.", option4: "It is a response matched to uncertainty in the ant's estimated endpoint.", correctAnswer: "It is a response matched to uncertainty in the ant's estimated endpoint.", explanation: "Step 1: Search is a controlled strategy used when precision declines.<br><br>Answer: It is a response matched to uncertainty in the ant's estimated endpoint.", practiceYear: 1, difficulty: "Very Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
135: {skill_tested: "Derive a broader principle.", question: "The experiments most strongly support which principle?", option1: "Reliable behavior can emerge from revising several uncertain signals rather than trusting one perfectly.", option2: "A useful compass must never change.", option3: "Conflicting evidence should always be ignored.", option4: "Memory is accurate only when landmarks are visible.", correctAnswer: "Reliable behavior can emerge from revising several uncertain signals rather than trusting one perfectly.", explanation: "Step 1: Navigation succeeds through comparison and calibration, not a flawless sensor.<br><br>Answer: Reliable behavior can emerge from revising several uncertain signals rather than trusting one perfectly.", practiceYear: 1, difficulty: "Very Hard", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"}
}
