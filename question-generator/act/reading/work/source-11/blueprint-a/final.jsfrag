{
199: {skill_tested: "Identify an explicitly stated mechanism.", question: "According to the passage, how does evaporation cool the clay wall?", option1: "Escaping water molecules carry energy away from the wall.", option2: "Clay converts water directly into electrical energy.", option3: "Warm air becomes heavier and remains near the floor.", option4: "Mineral deposits absorb all heat released by produce.", correctAnswer: "Escaping water molecules carry energy away from the wall.", explanation: "Step 1: Water enters pores in the clay and some of it evaporates.<br><br>Step 2: The fastest molecules escape with energy, lowering the wall's thermal energy.<br><br>Answer: Escaping water molecules carry energy away from the wall.", practiceYear: 1, difficulty: "Medium", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
200: {skill_tested: "Identify the purpose of a design feature.", question: "The thin ribs and hollow blocks are used primarily to:", option1: "reduce the amount of produce that can fit in the room.", option2: "increase the wet surface exposed to air.", option3: "prevent all air from leaving through the roof.", option4: "store drinking water inside sealed clay.", correctAnswer: "increase the wet surface exposed to air.", explanation: "Step 1: Evaporation occurs where wet clay meets moving air.<br><br>Step 2: Ribs and hollow blocks expose more surface than a flat wall using the same clay.<br><br>Answer: increase the wet surface exposed to air.", practiceYear: 1, difficulty: "Medium", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
201: {skill_tested: "Identify the passage's central claim.", question: "Which statement best expresses the central idea of the passage?", option1: "Porous-clay rooms duplicate mechanical refrigeration in every climate.", option2: "The largest possible cooling room is always the most efficient design.", option3: "Evaporative cooling can extend produce storage when its design and operation match local climate and resources.", option4: "Low-technology storage requires no measurement or maintenance.", correctAnswer: "Evaporative cooling can extend produce storage when its design and operation match local climate and resources.", explanation: "Step 1: The passage explains a valid cooling mechanism and useful prototype results.<br><br>Step 2: Humidity, water, airflow, operation, and scale limit performance.<br><br>Answer: Evaporative cooling can extend produce storage when its design and operation match local climate and resources.", practiceYear: 1, difficulty: "Medium", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
202: {skill_tested: "Infer the effect of atmospheric humidity on the system.", question: "Why would the same room generally cool less effectively on a humid afternoon than on a dry afternoon?", option1: "Humid air causes all clay pores to become larger.", option2: "Vegetables stop releasing heat whenever humidity rises.", option3: "Roof shade works only during dry weather.", option4: "Air already containing substantial water vapor accepts additional vapor more slowly.", correctAnswer: "Air already containing substantial water vapor accepts additional vapor more slowly.", explanation: "Step 1: Cooling depends on water evaporating from the clay.<br><br>Step 2: The passage states that evaporation slows when surrounding air already contains substantial vapor.<br><br>Step 3: Slower evaporation carries away less energy during the same period.<br><br>Answer: Air already containing substantial water vapor accepts additional vapor more slowly.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
203: {skill_tested: "Analyze a resource tradeoff.", question: "The statement about exchanging one resource problem for another refers to the risk that:", option1: "saving electricity could require consuming scarce drinking water.", option2: "collecting roof runoff could increase the need for refrigeration.", option3: "clay walls could cause vegetables to consume electricity.", option4: "filtered wash water could eliminate evaporation.", correctAnswer: "saving electricity could require consuming scarce drinking water.", explanation: "Step 1: The room avoids much of the electricity required by refrigeration.<br><br>Step 2: It still needs water, which may be scarce in the dry regions where evaporation works best.<br><br>Step 3: Using potable water could shift rather than solve the resource burden.<br><br>Answer: saving electricity could require consuming scarce drinking water.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
204: {skill_tested: "Interpret a concise authorial statement.", question: "By stating that a low-technology device is not a device without technique, the author emphasizes that:", option1: "only engineers can place crates inside the room.", option2: "simple materials still require informed operation and monitoring.", option3: "temperature records make clay walls unnecessary.", option4: "construction quality has no effect on performance.", correctAnswer: "simple materials still require informed operation and monitoring.", explanation: "Step 1: Blocked airflow and open doors can reduce cooling.<br><br>Step 2: Operators can use records to adjust loading and detect clogs.<br><br>Step 3: Material simplicity does not remove the need for skilled practices.<br><br>Answer: simple materials still require informed operation and monitoring.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
205: {skill_tested: "Analyze a scaling dilemma.", question: "Why might dividing a large room into narrower chambers improve passive cooling?", option1: "Narrow chambers guarantee that humidity remains at zero.", option2: "They use less wall material in every design.", option3: "They can reduce poorly circulated central space without requiring electric fans.", option4: "They prevent workers from changing loading schedules.", correctAnswer: "They can reduce poorly circulated central space without requiring electric fans.", explanation: "Step 1: Air near the center of a large room may circulate poorly.<br><br>Step 2: Fans improve mixing but add an electricity requirement.<br><br>Step 3: Narrower chambers shorten circulation paths while retaining a passive system, though they add other costs.<br><br>Answer: They can reduce poorly circulated central space without requiring electric fans.", practiceYear: 1, difficulty: "Hard", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
206: {skill_tested: "Evaluate evidence needed to generalize prototype results.", question: "Which additional evidence would most strengthen a claim that the prototype design is broadly useful?", option1: "A photograph showing that the clay walls have an appealing color", option2: "A single afternoon temperature from the coolest point beside one wall", option3: "The opinion of an operator before any produce is stored", option4: "Measurements across dry and humid seasons for several crops, including water use and spoilage rates", correctAnswer: "Measurements across dry and humid seasons for several crops, including water use and spoilage rates", explanation: "Step 1: Performance varies with season, humidity, crop, and resource use.<br><br>Step 2: A broad claim must test those variables rather than rely on one favorable reading.<br><br>Step 3: Repeated comparative evidence about temperature, water, and actual spoilage addresses both benefit and cost.<br><br>Answer: Measurements across dry and humid seasons for several crops, including water use and spoilage rates", practiceYear: 1, difficulty: "Very Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
207: {skill_tested: "Synthesize mechanism and context in judging appropriate technology.", question: "The final paragraph suggests that the design's value should be judged primarily by whether it:", option1: "uses a sustainable mechanism to provide enough cooling for a locally meaningful storage benefit.", option2: "matches refrigeration at every temperature and scale.", option3: "eliminates every loss between harvest and sale.", option4: "can be enlarged without changes in airflow or material use.", correctAnswer: "uses a sustainable mechanism to provide enough cooling for a locally meaningful storage benefit.", explanation: "Step 1: The author does not claim replacement of refrigeration in all settings.<br><br>Step 2: Moderate cooling can still extend selling flexibility.<br><br>Step 3: The requirements of evaporation, water, climate, and operation must be maintainable where the room is used.<br><br>Answer: uses a sustainable mechanism to provide enough cooling for a locally meaningful storage benefit.", practiceYear: 1, difficulty: "Very Hard", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"}
}
