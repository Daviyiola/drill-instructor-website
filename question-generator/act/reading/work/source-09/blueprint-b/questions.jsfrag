{
172: {skill_tested: "Identify the earliest indicators described in a restoration sequence.", question: "According to Passage A, which changes are generally monitored first after concrete channel walls are removed?", option1: "The return of every fish species formerly present", option2: "Changes in flow, floodplain contact, and sediment deposition", option3: "The number of visitors using new overlooks", option4: "The maturity of newly established riverside trees", correctAnswer: "Changes in flow, floodplain contact, and sediment deposition", explanation: "Step 1: Removing the channel allows water to slow, curve, spread, and deposit sediment.<br><br>Step 2: Passage A identifies these physical changes as the first indicators often monitored.<br><br>Answer: Changes in flow, floodplain contact, and sediment deposition", practiceYear: 1, difficulty: "Medium", module: "Sequence and Relationships", imageSources: [], passage: "{{shared_passage}}"},
173: {skill_tested: "Identify a stated contribution of resident monitoring.", question: "According to Passage B, how did the stewardship group respond to the cloudy-water event?", option1: "It waited for the annual report before observing the river.", option2: "It measured the population of every fish species.", option3: "It photographed the plume and traced it to a street inlet.", option4: "It permanently closed both river entrances.", correctAnswer: "It photographed the plume and traced it to a street inlet.", explanation: "Step 1: Walkers saw cloudy water between scheduled sampling dates.<br><br>Step 2: They documented the plume and followed it to a street inlet.<br><br>Answer: It photographed the plume and traced it to a street inlet.", practiceYear: 1, difficulty: "Medium", module: "Textual Details", imageSources: [], passage: "{{shared_passage}}"},
174: {skill_tested: "Identify a shared view of restoration assessment.", question: "Both passages characterize restoration assessment as:", option1: "a judgment that should depend on a single visible sign.", option2: "a task that can be completed before construction begins.", option3: "a choice between scientific measurements and public observation.", option4: "an ongoing process requiring different observations over time.", correctAnswer: "an ongoing process requiring different observations over time.", explanation: "Step 1: Passage A compares multiple indicators, seasons, and reference reaches.<br><br>Step 2: Passage B describes repeated public observation and revisions to access.<br><br>Answer: an ongoing process requiring different observations over time.", practiceYear: 1, difficulty: "Medium", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"},
175: {skill_tested: "Analyze the function of contrasting interpretations of one indicator.", question: "Passage A's discussion of clear water and abundant algae primarily demonstrates that:", option1: "visible conditions require context from other indicators before they establish ecological health.", option2: "clear water always contains too few nutrients for any organism.", option3: "algae are reliable proof that runoff has damaged a river.", option4: "scientists should replace field observations with visitor counts.", correctAnswer: "visible conditions require context from other indicators before they establish ecological health.", explanation: "Step 1: Clear water and algae can each correspond to more than one ecological condition.<br><br>Step 2: The passage says evidence gains meaning through patterns among many indicators.<br><br>Step 3: The examples warn against treating appearance as a decisive measure.<br><br>Answer: visible conditions require context from other indicators before they establish ecological health.", practiceYear: 1, difficulty: "Hard", module: "Function and Structure", imageSources: [], passage: "{{shared_passage}}"},
176: {skill_tested: "Infer how adaptive access supports restoration.", question: "The stewardship group's decision to move a path rather than merely post warnings suggests that the group viewed visitor behavior as:", option1: "fixed and unrelated to the design of the site.", option2: "something that could be redirected through changes to the physical setting.", option3: "a reason to abandon public access entirely.", option4: "more important than every biological measure.", correctAnswer: "something that could be redirected through changes to the physical setting.", explanation: "Step 1: A shortcut damaged young plants despite the existing route.<br><br>Step 2: Moving the path changed the convenient behavior available to visitors.<br><br>Step 3: The response treats use as adjustable through design, not simply disobedient.<br><br>Answer: something that could be redirected through changes to the physical setting.", practiceYear: 1, difficulty: "Hard", module: "Inference and Implication", imageSources: [], passage: "{{shared_passage}}"},
177: {skill_tested: "Compare how passages handle distinct forms of evidence.", question: "Which statement accurately compares the roles assigned to evidence in the two passages?", option1: "Passage A rejects seasonal comparison, while Passage B rejects all laboratory analysis.", option2: "Passage A measures only visitor use, while Passage B measures only water temperature.", option3: "Passage A combines ecological indicators to interpret recovery, while Passage B uses recurring public presence to widen observation and support stewardship.", option4: "Both passages argue that one successful observation proves permanent recovery.", correctAnswer: "Passage A combines ecological indicators to interpret recovery, while Passage B uses recurring public presence to widen observation and support stewardship.", explanation: "Step 1: Passage A relates flow, temperature, sediment, plants, insects, and fish across time.<br><br>Step 2: Passage B emphasizes walkers' repeated observations and their role in maintenance and advocacy.<br><br>Step 3: The evidence serves different but compatible assessment functions.<br><br>Answer: Passage A combines ecological indicators to interpret recovery, while Passage B uses recurring public presence to widen observation and support stewardship.", practiceYear: 1, difficulty: "Hard", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"},
178: {skill_tested: "Analyze a qualification about public-use measures.", question: "Why does Passage B call the distinction between amenities and ecological success useful in some circumstances?", option1: "It establishes that paths can never contribute to long-term stewardship.", option2: "It permits residents to replace every scheduled scientific survey.", option3: "It shows that ecological processes matter only when people observe them.", option4: "It prevents visitor counts from being treated as direct proof of fish populations or water quality.", correctAnswer: "It prevents visitor counts from being treated as direct proof of fish populations or water quality.", explanation: "Step 1: The passage says social and ecological measures are not interchangeable.<br><br>Step 2: It specifically warns against mistaking visitor counts for evidence about fish or water quality.<br><br>Step 3: The distinction protects the meaning of each measure while allowing interaction between them.<br><br>Answer: It prevents visitor counts from being treated as direct proof of fish populations or water quality.", practiceYear: 1, difficulty: "Hard", module: "Author's Purpose and Perspective", imageSources: [], passage: "{{shared_passage}}"},
179: {skill_tested: "Synthesize temporal and social dimensions of durable recovery.", question: "Taken together, the passages most strongly support which conclusion about a restoration project's durability?", option1: "Ecological processes need time and connected conditions, while informed public involvement can help detect and address threats during that recovery.", option2: "Durability is guaranteed once the river channel follows a curved path.", option3: "Durability depends only on attracting the highest possible number of visitors.", option4: "Public access and ecological monitoring should occur in separate locations so they cannot influence one another.", correctAnswer: "Ecological processes need time and connected conditions, while informed public involvement can help detect and address threats during that recovery.", explanation: "Step 1: Passage A describes biological lags and barriers beyond the project boundary.<br><br>Step 2: Passage B shows residents detecting problems and adapting use.<br><br>Step 3: Durable recovery therefore combines long-term ecological conditions with continuing capacity to notice and respond.<br><br>Answer: Ecological processes need time and connected conditions, while informed public involvement can help detect and address threats during that recovery.", practiceYear: 1, difficulty: "Very Hard", module: "Central Ideas and Themes", imageSources: [], passage: "{{shared_passage}}"},
180: {skill_tested: "Distinguish complementary endpoints from interchangeable measures.", question: "Which choice best captures the relationship between the final claims of Passage A and Passage B?", option1: "Passage A rejects any judgment of failure, whereas Passage B declares every accessible project successful.", option2: "Passage A calls for diagnosing stages and barriers in ecological recovery, while Passage B argues that civic relationships can help that recovery persist without substituting for ecological evidence.", option3: "Passage A treats patience as impossible to measure, while Passage B treats public use as impossible to redesign.", option4: "Both passages define success exclusively as returning the river to its exact preconstruction state.", correctAnswer: "Passage A calls for diagnosing stages and barriers in ecological recovery, while Passage B argues that civic relationships can help that recovery persist without substituting for ecological evidence.", explanation: "Step 1: Passage A replaces a quick success-or-failure verdict with measures of begun, delayed, and blocked processes.<br><br>Step 2: Passage B distinguishes social measures from ecological ones while connecting witnesses to stewardship.<br><br>Step 3: The claims are complementary because one defines recovery and the other addresses a relationship that may sustain it.<br><br>Answer: Passage A calls for diagnosing stages and barriers in ecological recovery, while Passage B argues that civic relationships can help that recovery persist without substituting for ecological evidence.", practiceYear: 1, difficulty: "Very Hard", module: "Comparative Passage Analysis", imageSources: [], passage: "{{shared_passage}}"}
}
