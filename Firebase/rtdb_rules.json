{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["uid"],
      "$studentId": {
        "statsIndex": {
          ".indexOn": ["submittedAt", "bootcampSubmittedAt"]
        }
      }
    },
    "challenges": {
      ".indexOn": ["expiresAt"]
    },
    "challengeKeys": {
      ".indexOn": ["expiresAt"]
    },
    "stripeSubscriptions": {
      ".indexOn": ["userId"]
    }
  }
}
